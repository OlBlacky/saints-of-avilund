---
import Base from '../../layouts/Base.astro';
import Campaigns from '../../components/campaigns/Campaigns.tsx';

// Campaigns (builder spec §13) — the DM's tool. A Campaign lives in this
// browser, beside the character roster; the table itself carries grants
// to the players' sheets. This page is the list and, behind ?id=, a
// campaign's home.
---

<Base title="Campaigns" description="Campaigns — the DM's table: roster, Sessions, and what was granted.">
  <p class="eyebrow">The Record</p>
  <h1>Campaigns</h1>

  <Campaigns client:only="preact" />

  <style is:global>
    .roster { margin-top: 1.6rem; }
    .roster-note {
      border-left: 3px solid var(--gold); padding-left: 0.8rem;
      color: var(--ink-soft); margin: 0 0 1rem;
    }
    .roster-table { border-collapse: collapse; width: 100%; }
    .roster-table th {
      font-variant: small-caps; font-weight: normal; letter-spacing: 0.05em;
      color: var(--gold); text-align: left; padding: 0.2rem 0.7rem;
      border-bottom: 1px solid var(--gold); font-size: 0.85rem;
    }
    .roster-table td { padding: 0.45rem 0.7rem; border-bottom: 1px solid var(--rule); }
    .roster-table td.act { text-align: right; white-space: nowrap; }
    .roster-table td.act .buy, .roster-table td.act .undo { margin-left: 0.4rem; }
    .roster-table a { text-decoration: none; }
    .roster .buy, .roster .undo {
      font: inherit; font-size: 0.85rem; padding: 0.15rem 0.55rem; cursor: pointer;
      border: 1px solid var(--gold); border-radius: 3px;
      background: transparent; color: var(--oxblood); text-decoration: none;
    }
    .roster .undo { border-color: var(--rule); color: var(--ink-soft); }
    .roster .buy:hover { background: var(--gold); color: var(--panel); }
    .roster-actions { display: flex; gap: 0.8rem; align-items: center; margin-top: 1.4rem; flex-wrap: wrap; }
    .roster .cf-crystallize {
      padding: 0.45rem 0.9rem; cursor: pointer;
      font-family: var(--display); font-size: 0.98rem;
      color: var(--panel); background: var(--oxblood);
      border: 1px solid var(--oxblood); border-radius: 3px;
    }
    .roster .cf-loading, .roster .cf-how { color: var(--ink-soft); }
    .roster .roster-field {
      font: inherit; padding: 0.35rem 0.6rem;
      border: 1px solid var(--rule); border-radius: 3px;
      background: transparent; color: inherit;
    }
    .roster .roster-field--level { width: 4.5rem; }
    .roster .roster-import { cursor: pointer; }
    .roster .cf-roll {
      padding: 0.45rem 0.9rem; cursor: pointer;
      font-family: var(--display); font-size: 0.98rem;
      color: var(--oxblood); background: transparent;
      border: 1px solid var(--gold); border-radius: 3px;
    }
    .roster .cf-roll:hover { background: var(--gold); color: var(--panel); }
    .session-log { margin-top: 1.8rem; }
    .session { margin: 0 0 1.1rem; }
    .session-head { display: flex; gap: 0.8rem; align-items: center; margin-bottom: 0.4rem; }
    .session-notes { display: block; width: 100%; min-height: 4.5rem; resize: vertical; }
    .campaign-name {
      display: block; width: 100%; font-family: var(--display); font-size: 1.7rem;
      color: inherit; background: transparent; border: 1px solid transparent;
      border-radius: 3px; padding: 0.1rem 0.3rem; margin: 0 0 0.3rem -0.3rem;
    }
    .campaign-name:hover, .campaign-name:focus { border-color: var(--rule); }
    .campaign-tabs { display: flex; gap: 0.6rem; margin: 1.2rem 0 0.4rem; }
    .roster .campaign-tab.on { background: var(--gold); color: var(--panel); }
    .sheet-statelabel {
      display: inline-flex; align-items: center; gap: 0.4rem;
      font-variant: small-caps; letter-spacing: 0.05em;
      color: var(--gold); font-size: 0.85rem;
    }
    .module { margin-top: 1rem; }
    .module-section { border-top: 1px dotted var(--rule); padding: 0.6rem 0; }
    .module-section > summary {
      cursor: pointer; font-variant: small-caps; letter-spacing: 0.05em;
      color: var(--gold);
    }
    .module-fields { display: flex; flex-wrap: wrap; gap: 0.7rem 1.2rem; margin-top: 0.7rem; }
    .module-field { flex: 1 1 20rem; }
    .module-field input { flex: 1; }
    .module-artwork { display: flex; align-items: center; gap: 0.8rem; }
    .module-artwork img {
      display: block; max-width: 9rem; max-height: 12rem;
      border: 1px solid var(--rule); border-radius: 3px;
    }
    .module-group { margin: 0.9rem 0; }
    .module-group > strong {
      display: block; margin-bottom: 0.4rem;
      font-variant: small-caps; font-weight: normal; letter-spacing: 0.05em;
      color: var(--gold); font-size: 0.85rem;
    }
    .module-item {
      border-left: 3px solid var(--rule); padding-left: 0.8rem; margin-bottom: 0.8rem;
    }
    .module-code { width: 5.5rem; }
    .module-reward { border-left: 3px solid var(--gold); padding-left: 0.8rem; }
    .module-reward-part { margin: 0.7rem 0; }
    .module-reward-label {
      display: block; margin-bottom: 0.3rem;
      font-variant: small-caps; letter-spacing: 0.05em;
      color: var(--ink-soft); font-size: 0.85rem;
    }
    .module-reward .grant-recipient { display: block; margin-bottom: 0.25rem; }
    .module-mark-rule { min-height: 3.2rem; }

    /* The book view — the Module read as a book, on screen and to print. */
    .book-wrap { margin-top: 1rem; }
    .book-controls { display: flex; gap: 0.8rem; align-items: center; margin-bottom: 1.2rem; }
    .book-view { position: relative; }
    .book-page {
      border-top: 1px dotted var(--rule); padding: 1.4rem 0;
    }
    .book-cover { text-align: center; padding: 3rem 0; }
    .book-cover h1 { margin: 0.8rem 0 0.2rem; }
    .book-cover-art { max-width: 100%; max-height: 24rem; border: 1px solid var(--rule); }
    .book-subtitle { font-style: italic; margin: 0.2rem 0; }
    .book-banner { font-variant: small-caps; letter-spacing: 0.05em; color: var(--gold); margin: 0.6rem 0 0; }
    .book-series, .book-imprint, .book-artcredit { color: var(--ink-soft); margin: 0.3rem 0 0; font-size: 0.9rem; }
    .book-inside dl { margin: 0; }
    .book-inside dt {
      font-variant: small-caps; letter-spacing: 0.05em; color: var(--gold);
      font-size: 0.85rem; margin-top: 0.6rem;
    }
    .book-inside dd { margin: 0.1rem 0 0; }
    .book-toc { margin: 0.4rem 0 0 1.2rem; padding: 0; list-style: none; }
    .book-toc li { margin: 0.25rem 0; }
    .book-toc-book { font-variant: small-caps; letter-spacing: 0.05em; color: var(--gold); margin-top: 0.7rem; }
    .book-prose { white-space: pre-wrap; }
    .book-summaryline { font-style: italic; color: var(--ink-soft); }
    .book-entry { margin: 1rem 0; }
    .book-entry h4 { margin: 0 0 0.3rem; }
    .book-tag {
      font-variant: small-caps; letter-spacing: 0.05em; color: var(--ink-soft);
      font-weight: normal; font-size: 0.8rem; margin-left: 0.5rem;
    }
    .book-map { display: block; max-width: 100%; border: 1px solid var(--rule); }
    .book-reward { border-left: 3px solid var(--gold); padding-left: 0.8rem; margin-top: 1rem; }
    .book-reward h4 { margin: 0 0 0.3rem; }
    .book-watermark {
      text-align: center; font-variant: small-caps; letter-spacing: 0.1em;
      color: #7a2828; border: 1px solid rgba(120, 40, 40, 0.4);
      border-radius: 3px; padding: 0.3rem 0.8rem; margin-bottom: 1rem;
    }

    @media print {
      /* Print the book alone: everything hides, the book view stands. */
      html.book-mode body * { visibility: hidden; }
      html.book-mode .book-view, html.book-mode .book-view * { visibility: visible; }
      html.book-mode .book-view { position: absolute; left: 0; top: 0; width: 100%; }
      html.book-mode .book-controls { display: none; }
      .book-page { border-top: none; page-break-before: always; }
      .book-page:first-of-type { page-break-before: avoid; }
      .book-cover { padding-top: 20vh; }
      /* The draft watermark rides on every printed page. */
      html.book-mode .book-watermark {
        visibility: visible;
        position: fixed; top: 45vh; left: 0; right: 0;
        text-align: center; transform: rotate(-24deg);
        font-size: 2.2rem; letter-spacing: 0.1em;
        color: rgba(120, 40, 40, 0.18); z-index: 10;
        border: none; padding: 0; margin: 0;
      }
    }
    .module-identity { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 1rem; }
    .module-identity .module-wide { flex: 1 1 16rem; }
    .module-identity .module-wide input { flex: 1; }
    .module-text { display: block; width: 100%; min-height: 7rem; resize: vertical; margin-bottom: 0.6rem; }
    .module-outline { margin-bottom: 1.4rem; }
    .module-chapter { border-top: 1px dotted var(--rule); padding-top: 0.8rem; margin-bottom: 1.2rem; }
    .module-chapter-head { display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.5rem; }
    .module-chapter-head strong { white-space: nowrap; }
    .module-grow { flex: 1; }
    .module-chapter > input.module-wide { display: block; width: 100%; margin-bottom: 0.5rem; }
    .grant-form { margin-top: 1rem; }
    .grant-what { display: block; width: 100%; }
    .grant-recipients { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; margin: 0.6rem 0; }
    .grant-recipient { cursor: pointer; }
  </style>
</Base>

---
import Base from '../../layouts/Base.astro';
import Campaigns from '../../components/campaigns/Campaigns.tsx';

// Campaigns (builder spec §13) — the DM's tool. A Campaign lives in this
// browser, beside the character roster; the table itself carries grants
// to the players' sheets. This page is the list and, behind ?id=, a
// campaign's home.
---

<Base title="Campaigns" description="Campaigns — the DM's table: roster, Sessions, and what was granted.">
  <p class="eyebrow">The Record</p>
  <h1>Campaigns</h1>

  <Campaigns client:only="preact" />

  <style is:global>
    .roster { margin-top: 1.6rem; }
    .roster-note {
      border-left: 3px solid var(--gold); padding-left: 0.8rem;
      color: var(--ink-soft); margin: 0 0 1rem;
    }
    .roster-table { border-collapse: collapse; width: 100%; }
    .roster-table th {
      font-variant: small-caps; font-weight: normal; letter-spacing: 0.05em;
      color: var(--gold); text-align: left; padding: 0.2rem 0.7rem;
      border-bottom: 1px solid var(--gold); font-size: 0.85rem;
    }
    .roster-table td { padding: 0.45rem 0.7rem; border-bottom: 1px solid var(--rule); }
    .roster-table td.act { text-align: right; white-space: nowrap; }
    .roster-table td.act .buy, .roster-table td.act .undo { margin-left: 0.4rem; }
    .roster-table a { text-decoration: none; }
    .roster .buy, .roster .undo {
      font: inherit; font-size: 0.85rem; padding: 0.15rem 0.55rem; cursor: pointer;
      border: 1px solid var(--gold); border-radius: 3px;
      background: transparent; color: var(--oxblood); text-decoration: none;
    }
    .roster .undo { border-color: var(--rule); color: var(--ink-soft); }
    .roster .buy:hover { background: var(--gold); color: var(--panel); }
    .roster-actions { display: flex; gap: 0.8rem; align-items: center; margin-top: 1.4rem; flex-wrap: wrap; }
    .roster .cf-crystallize {
      padding: 0.45rem 0.9rem; cursor: pointer;
      font-family: var(--display); font-size: 0.98rem;
      color: var(--panel); background: var(--oxblood);
      border: 1px solid var(--oxblood); border-radius: 3px;
    }
    .roster .cf-loading, .roster .cf-how { color: var(--ink-soft); }
    .roster .roster-field {
      font: inherit; padding: 0.35rem 0.6rem;
      border: 1px solid var(--rule); border-radius: 3px;
      background: transparent; color: inherit;
    }
    .roster .roster-field--level { width: 4.5rem; }
    .roster .roster-import { cursor: pointer; }
    .roster .cf-roll {
      padding: 0.45rem 0.9rem; cursor: pointer;
      font-family: var(--display); font-size: 0.98rem;
      color: var(--oxblood); background: transparent;
      border: 1px solid var(--gold); border-radius: 3px;
    }
    .roster .cf-roll:hover { background: var(--gold); color: var(--panel); }
    .session-log { margin-top: 1.8rem; }
    .session { margin: 0 0 1.1rem; }
    .session-head { display: flex; gap: 0.8rem; align-items: center; margin-bottom: 0.4rem; }
    .session-notes { display: block; width: 100%; min-height: 4.5rem; resize: vertical; }
    .campaign-tabs { display: flex; gap: 0.6rem; margin: 1.2rem 0 0.4rem; }
    .roster .campaign-tab.on { background: var(--gold); color: var(--panel); }
    .sheet-statelabel {
      display: inline-flex; align-items: center; gap: 0.4rem;
      font-variant: small-caps; letter-spacing: 0.05em;
      color: var(--gold); font-size: 0.85rem;
    }
    .module { margin-top: 1rem; }
    .module-identity { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 1rem; }
    .module-identity .module-wide { flex: 1 1 16rem; }
    .module-identity .module-wide input { flex: 1; }
    .module-text { display: block; width: 100%; min-height: 7rem; resize: vertical; margin-bottom: 0.6rem; }
    .module-outline { margin-bottom: 1.4rem; }
    .module-chapter { border-top: 1px dotted var(--rule); padding-top: 0.8rem; margin-bottom: 1.2rem; }
    .module-chapter-head { display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.5rem; }
    .module-chapter-head strong { white-space: nowrap; }
    .module-grow { flex: 1; }
    .module-chapter > input.module-wide { display: block; width: 100%; margin-bottom: 0.5rem; }
    .grant-form { margin-top: 1rem; }
    .grant-what { display: block; width: 100%; }
    .grant-recipients { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; margin: 0.6rem 0; }
    .grant-recipient { cursor: pointer; }
  </style>
</Base>

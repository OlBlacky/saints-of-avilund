---
import Base from '../../../layouts/Base.astro';
import { url } from '../../../lib/url';
import { getCollection } from 'astro:content';
import SystemNav from '../../../components/SystemNav.astro';

// Alphabetical by title (standing order, matching the Abilities page);
// the frontmatter `order` field is retired for sorting.
const classes = (await getCollection('classes'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Base title="Character Classes" description="The eleven character Classes of Saints of Avilund — their Attributes, Subclasses, and Abilities.">
  <p class="back-link"><a href={url('system/')}>← The System</a></p>

  <p class="eyebrow">The System</p>
  <h1>Character Classes</h1>
  <p class="lede">
    Eleven Classes, each with three Subclasses — distinct builds that share a common core.
    (More Classes will appear here as they are finished.)
  </p>

  <ul class="doc-list">
    {classes.map((c) => (
      <li>
        <div class="doc-list__text">
          <a class="title" href={url(`system/classes/${c.id}/`)}>{c.data.title}</a>
          {c.data.portfolio && <div class="by"><em>{c.data.portfolio}</em></div>}
          {c.data.summary && <p class="card__blurb">{c.data.summary}</p>}
        </div>
      </li>
    ))}
  </ul>

  <SystemNav slug="classes" />
</Base>
